# For a machine without Docker:  sudo cp this file to /etc/systemd/system/, adjust User and paths, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now legacy-player-server
[Unit]
Description=Legacy Player shared server
After=network-online.target
Wants=network-online.target

[Service]
User=legacyplayer
WorkingDirectory=/opt/legacy-player
ExecStart=/usr/bin/python3 -m server.cli start --share --port 8765 --state-dir /var/lib/legacy-player/state --replay-dir /var/lib/legacy-player/replays
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/legacy-player
# No capabilities at all: the server listens on 8765 (above 1024). setup-vps.sh adds CAP_NET_BIND_SERVICE in a drop-in
# (legacy-player-server.service.d/low-port.conf) only when LP_PORT is below 1024.
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
PrivateDevices=yes
UMask=0077
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
